// ===== WAIT FOR DOM TO LOAD =====
document.addEventListener('DOMContentLoaded', function() {

// ===== THEME TOGGLE =====
const themeToggle = document.getElementById('themeToggle');
const html = document.documentElement;

const currentTheme = localStorage.getItem('theme') || 'light';
html.setAttribute('data-theme', currentTheme);

if (themeToggle) {
    themeToggle.addEventListener('click', () => {
        const theme = html.getAttribute('data-theme');
        const newTheme = theme === 'light' ? 'dark' : 'light';
        
        html.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
        
        // Update particle colors after theme change
        if (window.particleSystem) {
            window.particleSystem.updateColors();
        }
    });
}

// ===== 3D PARTICLE BACKGROUND =====
function initParticleBackground() {
    console.log('=== CHROME EXTENSION-AWARE PARTICLE SYSTEM ===');
    console.log('Browser:', navigator.userAgent);
    console.log('Chrome detected:', navigator.userAgent.includes('Chrome'));
    console.log('Incognito mode:', !window.chrome || !window.chrome.webstore);
    
    const canvas = document.getElementById('particleCanvas');
    if (!canvas) {
        console.error('Canvas element not found');
        return;
    }
    
    console.log('Canvas found, setting up context...');

    // Force cache busting for Chrome normal mode
    const isChrome = navigator.userAgent.includes('Chrome') && !navigator.userAgent.includes('Edge');
    const isIncognito = !window.chrome || !window.chrome.webstore;
    
    // Add cache-busting parameter for Chrome normal mode
    if (isChrome && !isIncognito) {
        canvas.style.display = 'none';
        canvas.offsetHeight; // Force reflow
        canvas.style.display = '';
        console.log('Cache busting applied for Chrome normal mode');
    }

    // Browser-specific canvas setup with extension conflict detection
    let ctx;
    let contextAttempt = 0;
    const maxAttempts = 3;
    
    function createContext(attempt) {
        try {
            console.log(`Context creation attempt ${attempt + 1}/${maxAttempts}`);
            
            if (isChrome) {
                // Chrome-specific setup with multiple fallbacks
                const contexts = [
                    () => canvas.getContext('2d', { 
                        alpha: true,
                        desynchronized: false,
                        willReadFrequently: false,
                        preserveDrawingBuffer: true
                    }),
                    () => canvas.getContext('2d', { 
                        alpha: true,
                        desynchronized: false
                    }),
                    () => canvas.getContext('2d'),
                    () => {
                        // Last resort - recreate canvas
                        const newCanvas = canvas.cloneNode(true);
                        canvas.parentNode.replaceChild(newCanvas, canvas);
                        return newCanvas.getContext('2d');
                    }
                ];
                
                for (let i = 0; i < contexts.length; i++) {
                    try {
                        const testCtx = contexts[i]();
                        if (testCtx) {
                            console.log(`Context created with method ${i + 1}`);
                            return testCtx;
                        }
                    } catch (e) {
                        console.log(`Context method ${i + 1} failed:`, e.message);
                    }
                }
            } else {
                // Edge and other browsers
                return canvas.getContext('2d');
            }
            
            throw new Error('All context creation methods failed');
        } catch (error) {
            console.error(`Context attempt ${attempt + 1} error:`, error);
            if (attempt < maxAttempts - 1) {
                setTimeout(() => createContext(attempt + 1), 100 * (attempt + 1));
            } else {
                console.error('All context creation attempts failed');
                return null;
            }
        }
    }
    
    ctx = createContext(contextAttempt);
    
    if (!ctx) {
        console.error('Could not create canvas context after all attempts');
        return;
    }
    
    console.log('Canvas context created successfully');

    // Universal canvas setup
    function resizeCanvas() {
        const width = window.innerWidth;
        const height = window.innerHeight;
        
        canvas.width = width;
        canvas.height = height;
        canvas.style.width = width + 'px';
        canvas.style.height = height + 'px';
        
        console.log('Canvas resized to:', width, 'x', height);
    }
    resizeCanvas();

    // Particle class
    class Particle {
        constructor() {
            const dpr = window.devicePixelRatio || 1;
            this.x = Math.random() * window.innerWidth;
            this.y = Math.random() * window.innerHeight;
            this.size = Math.random() * 3 + 1;
            this.speedX = (Math.random() - 0.5) * 0.5;
            this.speedY = (Math.random() - 0.5) * 0.5;
        }

        update() {
            this.x += this.speedX;
            this.y += this.speedY;

            if (this.x > window.innerWidth || this.x < 0) this.speedX *= -1;
            if (this.y > window.innerHeight || this.y < 0) this.speedY *= -1;
        }

        draw() {
            const theme = document.documentElement.getAttribute('data-theme');
            ctx.fillStyle = theme === 'dark' 
                ? 'rgba(100, 255, 218, 0.6)'
                : 'rgba(59, 130, 246, 0.4)';
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            ctx.fill();
        }
    }

    // Create particles
    const particles = [];
    const particleCount = 50;
    
    for (let i = 0; i < particleCount; i++) {
        particles.push(new Particle());
    }

    // Enhanced animation loop for Chrome compatibility
    let animationId;
    let frameCount = 0;
    
    function animate() {
        try {
            // Chrome-specific frame counter
            frameCount++;
            if (frameCount % 60 === 0) {
                console.log('Animation running, frame:', frameCount);
            }
            
            // Clear canvas with Chrome optimization
            if (isChrome) {
                ctx.save();
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                ctx.restore();
            } else {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
            }
            
            // Update and draw particles
            particles.forEach((particle, index) => {
                particle.update();
                particle.draw();
                
                // Debug first few particles in Chrome
                if (isChrome && index < 3 && frameCount % 120 === 0) {
                    console.log(`Particle ${index}: x=${particle.x.toFixed(1)}, y=${particle.y.toFixed(1)}`);
                }
            });
            
            // Draw connections
            const theme = document.documentElement.getAttribute('data-theme');
            let connectionCount = 0;
            
            for (let i = 0; i < particles.length; i++) {
                for (let j = i + 1; j < particles.length; j++) {
                    const dx = particles[i].x - particles[j].x;
                    const dy = particles[i].y - particles[j].y;
                    const distance = Math.sqrt(dx * dx + dy * dy);

                    if (distance < 100) {
                        connectionCount++;
                        ctx.strokeStyle = theme === 'dark' 
                            ? 'rgba(100, 255, 218, 0.2)'
                            : 'rgba(59, 130, 246, 0.15)';
                        ctx.lineWidth = 0.5;
                        ctx.beginPath();
                        ctx.moveTo(particles[i].x, particles[i].y);
                        ctx.lineTo(particles[j].x, particles[j].y);
                        ctx.stroke();
                    }
                }
            }
            
            // Log connection count periodically in Chrome
            if (isChrome && frameCount % 120 === 0) {
                console.log(`Active connections: ${connectionCount}`);
            }
            
            animationId = requestAnimationFrame(animate);
        } catch (error) {
            console.error('Animation error:', error);
            console.error('Frame:', frameCount);
            console.error('Canvas state:', canvas.width, 'x', canvas.height);
            
            // Restart animation if error occurs
            setTimeout(() => {
                if (animationId) cancelAnimationFrame(animationId);
                frameCount = 0;
function resizeCanvas() {
